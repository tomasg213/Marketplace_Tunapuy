// prisma/schema.prisma
// Esquema canónico del Marketplace_Tunapuy (Épica E0).
// Proveedor: PostgreSQL en TODOS los entornos (dev y prod) — decisión E0.
//
// Ajustes de auth OTP confirmados por el PM (vs. docs/architecture.md v1):
//   - User.phoneNumber: String @unique  → identificador de login (obligatorio).
//   - User.email:       String? @unique → opcional, no requerido.
//   - Se elimina User.passwordHash (ya no hay contraseña; login por OTP).
//   - Nuevo modelo OtpCode (código NUNCA en texto plano: solo codeHash).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Tasa BCV (caché persistente)
// ---------------------------------------------------------------------------

model RateCache {
  id        String   @id @default(cuid())
  source    String   @unique // "dolarapi-oficial"
  usdToBs   Decimal  @db.Decimal(14, 4) // tasa promedio BCV (p.ej. 746.6297)
  fetchedAt DateTime // momento real del fetch (fechaActualizacion de la API)
  expiresAt DateTime // fetchedAt + TTL (renovación)
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Catálogo
// ---------------------------------------------------------------------------

model Category {
  id          String            @id @default(cuid())
  slug        String            @unique // comida | ropa | ... | tecnologia | servicios | joyas | manufactura | artesanias | construccion | ferreteria
  name        String // "Comida", "Ropa", ...
  description String?
  icon        String? // nombre del ícono (lucide-react)
  position    Int               @default(0) // orden de aparición en la home
  createdAt   DateTime          @default(now())
  products    ProductCategory[]

  @@index([position])
}

// ---------------------------------------------------------------------------
// Usuarios y vendedores
// ---------------------------------------------------------------------------

model User {
  id          String     @id @default(cuid())
  slug        String     @unique // URL amigable /vendedores/<slug> (backfill E2 ya aplicado)
  email       String?    @unique // opcional (cambio OTP)
  phoneNumber String     @unique // E.164, identificador de login (cambio OTP)
  name        String
  avatarUrl   String?
  role        String     @default("BUYER") // BUYER | SELLER | ADMIN (constantes TS)
  business    Business?
  products    Product[]  @relation("SellerProducts")
  sessions    Session[]  // sesiones opacas en BD (dictamen security E2, R4)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([role])
}

// ---------------------------------------------------------------------------
// Sesión opaca en BD (dictamen security-reviewer E2 — R4)
// ---------------------------------------------------------------------------
// El token de sesión es aleatorio (32 bytes, base64url); la BD solo guarda su
// sha256 (`tokenHash`), nunca el token en claro. `expiresAt` = createdAt + 30
// días (renovación deslizante: getSession lo extiende si queda < mitad de TTL).
// `lastVerifiedAt` alimenta la re-autenticación para acciones sensibles
// (publicar, cambiar teléfono) con `requireReauth()`. `revokedAt` permite el
// cierre de sesión / revocación puntual.

model Session {
  id             String    @id @default(cuid())
  tokenHash      String    @unique // sha256 del token aleatorio (nunca el token)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime  @default(now())
  lastVerifiedAt DateTime  @default(now()) // re-auth para acciones sensibles
  expiresAt      DateTime // createdAt + SESSION_TTL_SECONDS (30 días)
  revokedAt      DateTime? // null mientras la sesión esté activa

  // Barrido de vencidas + búsqueda por usuario
  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

// ---------------------------------------------------------------------------
// Rate limiting OTP en BD (dictamen security-reviewer E2 — R1)
// ---------------------------------------------------------------------------
// Un contador atómico por (key, ventana): `key` es el identificador lógico
// (p. ej. "request:phone:+584120000000:3600000") y `count` el número de hits
// en la ventana `[windowStart, windowEnd)`. El incremento es atómico
// (updateMany INCREMENT + create con retry P2002) — no es memoria de proceso:
// funciona en despliegues serverless multi-instancia.
// `AuthRateLimit` también guarda los bloques duros (30 min): key "block:...".

model AuthRateLimit {
  id          String   @id @default(cuid())
  key         String   @unique // "action:scope:windowMs" o "block:action:scope"
  count       Int      @default(0) // hits en la ventana (1 para un bloque activo)
  windowStart DateTime // inicio de la ventana / del bloque
  windowEnd   DateTime // fin de la ventana / del bloque
  createdAt   DateTime @default(now())

  // Barrido de ventanas/bloques vencidos
  @@index([windowEnd])
}

model Business {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  logoUrl     String?
  phoneNumber String? // E.164, contacto WhatsApp del negocio
  ownerId     String    @unique
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([ownerId])
}

// ---------------------------------------------------------------------------
// Auth OTP por teléfono (cambio E0)
// ---------------------------------------------------------------------------
// Un registro por intento de envío. El código en texto plano NUNCA se guarda:
// solo `codeHash` (HMAC-SHA256(AUTH_SECRET, salt + code) — R3, clave pepper).
// `attempts` cuenta los intentos de verificación; al superar `OTP_MAX_ATTEMPTS`
// el código se invalida. `consumedAt` marca el código como usado
// (login/registro completado).

model OtpCode {
  id          String    @id @default(cuid())
  phoneNumber String // E.164 del teléfono que solicita el código
  codeHash    String // HMAC-SHA256(AUTH_SECRET, salt + code), con salt por código (R3)
  type        String // LOGIN | REGISTER (constantes TS)
  expiresAt   DateTime // createdAt + OTP_TTL_MINUTES
  attempts    Int       @default(0) // intentos de verificación fallidos
  consumedAt  DateTime? // momento de uso; null mientras esté pendiente
  createdAt   DateTime  @default(now())

  // Búsqueda del último código pendiente por teléfono + tipo
  @@index([phoneNumber, type, createdAt(sort: Desc)])
  // Limpieza periódica de códigos vencidos
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Productos
// ---------------------------------------------------------------------------

model Product {
  id            String         @id @default(cuid())
  slug          String         @unique
  title         String
  description   String?
  priceUsd      Decimal        @db.Decimal(10, 2) // precio principal (divisas), requerido
  offerPriceUsd Decimal?       @db.Decimal(10, 2) // precio de oferta en divisas (opcional)
  phoneNumber   String // E.164 del anuncio; botón WhatsApp wa.me/<número sin '+'>
  status        String         @default("DRAFT") // DRAFT | ACTIVE | PAUSED | ARCHIVED | SOLD (R10: nuevos productos nacen como DRAFT)
  isFeatured    Boolean        @default(false) // destacado en la home
  featuredOrder Int            @default(0) // 0 = primera posición
  publishedAt   DateTime? // fecha de publicación; null mientras sea borrador ("recientes")
  categories    ProductCategory[] // multi-categoría: position 0 = categoría principal
  sellerId      String // dueño de la cuenta (siempre presente)
  seller        User           @relation("SellerProducts", fields: [sellerId], references: [id], onDelete: Cascade)
  businessId    String? // si se publica bajo un negocio
  business      Business?      @relation(fields: [businessId], references: [id], onDelete: SetNull)
  images        ProductImage[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // "recientes"
  @@index([status, publishedAt(sort: Desc)])
  // "destacados"
  @@index([isFeatured, featuredOrder])
  // navegación por vendedor
  @@index([sellerId])
  @@index([businessId])
}

// Tabla de unión producto ↔ categoría (épica "Categorías multi"):
// un producto pertenece a 1–3 categorías; `position` 0 = categoría principal
// (breadcrumb / ficha). `onDelete: Cascade` en producto; Restrict en categoría
// (no se puede borrar una categoría con productos asociados).
model ProductCategory {
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  position   Int      @default(0) // 0 = categoría principal (breadcrumb/ficha)
  createdAt  DateTime @default(now())

  @@id([productId, categoryId])
  @@index([categoryId])
  @@index([productId, position])
}

model ProductImage {
  id        String   @id @default(cuid())
  url       String
  key       String   @unique // object key (S3) / public_id (Cloudinary) para delete()
  alt       String?
  position  Int      @default(0)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId, position])
}
