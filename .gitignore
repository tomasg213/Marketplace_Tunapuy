# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# uploads en runtime (fuera de public/ — fix de fotos E3, se sirven por /uploads/[...key])
/.uploads/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (real values never committed; .env.example is committed on purpose)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Prisma (Prisma 7): cliente generado (se regenera con `prisma generate`)
/generated

# opencode: configuración local de agentes/skills (no se publica en GitHub)
.opencode/
