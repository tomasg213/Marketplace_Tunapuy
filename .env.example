# ==========================================================================
# Marketplace_Tunapuy — Variables de entorno (ejemplo)
# --------------------------------------------------------------------------
# Copia este archivo a `.env` y ajusta los valores para tu entorno local:
#   cp .env.example .env
# NUNCA commits valores reales (secretos). Este archivo es un template.
# ==========================================================================

# --------------------------------------------------------------------------
# Aplicación
# --------------------------------------------------------------------------
# Entorno de ejecución: development | test | production
NODE_ENV=development

# URL pública de la app (canonical, meta tags, redirects).
APP_URL=http://localhost:3000

# Modo de datos: mock (develop, seed con datos ficticios) | real (main, solo catálogo base).
# Controla qué siembra `prisma/seed.ts`. La app NO ramifica su lógica por esta variable.
DATA_MODE=mock

# Nombre público de la app (visible en cliente).
NEXT_PUBLIC_APP_NAME=Tunapuy

# Muestra un banner de "entorno de demostración" en la UI (opcional, mock only).
NEXT_PUBLIC_SHOW_MOCK_BANNER=false

# --------------------------------------------------------------------------
# Base de datos (PostgreSQL en TODOS los entornos — decisión E0)
# --------------------------------------------------------------------------
# Dev local: levanta el contenedor con `docker compose up -d`
# (Postgres 16, puerto 5432, DB tunapuy, user/pass postgres).
# Si no tienes Docker, usa un PostgreSQL local equivalente.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tunapuy"

# --------------------------------------------------------------------------
# Tasa BCV (dolarapi) — servicio de tasa para calcular precios en Bs.
# --------------------------------------------------------------------------
# URL de la API oficial (devuelve `promedio` y `fechaActualizacion`).
BCV_RATE_API_URL=https://ve.dolarapi.com/v1/dolares/oficial

# Frescura de la tasa en la tabla RateCache (horas). La tasa oficial cambia ~1 vez/día hábil.
BCV_RATE_TTL_HOURS=6

# TTL de la caché de memoria por proceso (minutos). Evita leer la DB en cada render.
BCV_RATE_TTL_MEMORY_MINUTES=10

# Timeout del fetch a la API en milisegundos.
BCV_RATE_TIMEOUT_MS=5000

# Tasa estática de respaldo si la API y la caché fallan (fallback en cascada).
# Puede quedar vacío: entonces el precio en Bs se oculta en la UI.
# En dev se recomienda fijarla para que el precio en Bs sea determinista en pruebas.
BCV_RATE_FALLBACK=746.6297

# --------------------------------------------------------------------------
# Auth — OTP por teléfono (decisión E0: login por teléfono + código OTP)
# --------------------------------------------------------------------------
# Proveedor de envío de OTP: dev (imprime el código en consola) | whatsapp (Meta Cloud API, stub).
#   dev      → usado en desarrollo: registra el código en la consola del servidor.
#   whatsapp → producción: envía el código por WhatsApp (Meta Cloud API). STUB por ahora.
OTP_PROVIDER=dev

# Duración de validez de cada código OTP en minutos.
OTP_TTL_MINUTES=5

# Intentos máximos de verificación antes de invalidar el código.
OTP_MAX_ATTEMPTS=5

# --- Meta Cloud API (WhatsApp Business) — SOLO si OTP_PROVIDER=whatsapp ---
# Token de acceso permanente (System User) generado en Meta Business Suite.
META_WHATSAPP_TOKEN=
# ID del número de teléfono del negocio (Phone Number ID).
META_WHATSAPP_PHONE_NUMBER_ID=
# ID de la cuenta de negocio de WhatsApp (WABA), opcional para auditoría.
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
# Plantilla aprobada para el mensaje de OTP (ej. "otp_verification").
META_WHATSAPP_OTP_TEMPLATE=otp_verification

# --------------------------------------------------------------------------
# Imágenes (contrato definido en E0; integración real en E3)
# --------------------------------------------------------------------------
IMAGE_PROVIDER=local            # local (dev) | s3 | cloudinary

# S3 (o compatible: R2, Backblaze) — si IMAGE_PROVIDER=s3
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=             # dominio público/CDN si se usa

# Cloudinary (alternativa) — si IMAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --------------------------------------------------------------------------
# Pagos (E3+ — contrato futuro, no usado en E0)
# --------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --------------------------------------------------------------------------
# Testing
# --------------------------------------------------------------------------
# URL base que usa Playwright para el smoke E2E (webServer lo levanta solo).
PLAYWRIGHT_BASE_URL=http://localhost:3000
# BD PostgreSQL aislada para las pruebas del seed (tests/unit/seed.test.ts).
# Si no se define, el test deriva "tunapuy_test" de DATABASE_URL.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tunapuy_test"
